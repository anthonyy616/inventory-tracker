[TEMPLATE]
# Add these to your inventory-tracking-system's .env file:

# Shared secret for receipt callbacks — MUST match RECEIPT_CALLBACK_SECRET in receipt service .env
RECEIPT_CALLBACK_SECRET=your-shared-secret-here

# The client UUID assigned to your inventory business in the receipt service
# (get this from the receipt service's /clients admin page)
RECEIPT_SERVICE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Receipt service URL (where the receipt service is running)
RECEIPT_SERVICE_URL=http://localhost:8001

# Shared secret for sending webhooks TO the receipt service — MUST match INVENTORY_WEBHOOK_SECRET in receipt service .env
INVENTORY_WEBHOOK_SECRET=your-inventory-webhook-secret-here
